# Copy this file to .env and fill in your keys.

# --- Model (GroqCloud) -----------------------------------------------------
# Free developer tier, no card required: https://console.groq.com
# Rate-limited rather than billed per token.
GROQ_API_KEY=gsk_your-key-here

# Optional — defaults shown. Text models with tool use on Groq:
#   openai/gpt-oss-120b   500 T/s   — best judgement (default)
#   openai/gpt-oss-20b   1000 T/s   — twice as fast, weaker reasoning
# Groq's docs list models your key may not actually be served (the Llama ones
# 404'd here) — check yours with client.models.list(). Avoid "preview" models;
# they can be withdrawn without notice.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Search ----------------------------------------------------------------
# Tavily gives cleaner ranked results and doesn't rate-limit the way the
# DuckDuckGo scraper does. Get a key at https://app.tavily.com
# Leave blank to fall back to DuckDuckGo (no API key required).
TAVILY_API_KEY=tvly-your-key-here

# --- Tuning (all optional) -------------------------------------------------
# MAX_TOKENS=1200
# MAX_TOOL_ROUNDS=4
# RECENT_TURNS=12
# RECALL_K=4
# SEARCH_CACHE_TTL=3600
