# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — defaults shown. Use a Haiku model for lower latency.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional — if set, the agent uses Tavily for higher-quality search.
# Leave blank to use DuckDuckGo (no API key required).
# TAVILY_API_KEY=tvly-your-key-here
